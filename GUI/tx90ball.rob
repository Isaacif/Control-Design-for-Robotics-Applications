### Kinematics of the Staubli TX90L robot ###
TParent 1 0 0   0 1 0   0 0 1   0 0 0 \
1 0 0   0 1 0   0 0 1   0 0 0.5   \
1 0 0   0 1 0   0 0 1 0 0 0.5  \
1 0 0   0 1 0   0 0 1  0 0.65 0
parents -1 0 1 2 
axis 0 0 1    0 0 1    1 0 0    1 0 0 
translation  0 0 0
#qMinDeg    0    -179   -147.5   -145   
#qMaxDeg    0    179    130       145    
qMinDeg    0    -179   -147.5   -145    
qMaxDeg    0    179    130       145    
#velMaxDeg  0    400    400      430    
#accMaxDeg  0    800    800      800   
velMaxDeg  0    10    10      10   
accMaxDeg  0    40    40      40   
geometry   "package/my_robot_description/base.stl" "package/my_robot_description/link1.stl" "package/my_robot_description/link2.stl" "package/my_robot_description/link3.stl"
geomscale 0.008 0.008 0.008 0.008 
mass       2 1 1 1 
automass
torqueMax  0 800 600 400

# simulation parameters
servoP  2000 2000 2000 
servoI  50 50 50  
servoD  25 25 25 
dryFriction 5 5 3  
viscousFriction 10 10 10 

noselfcollision 0 2
noselfcollision 0 3
noselfcollision 1 2
noselfcollision 1 3
noselfcollision 2 3
